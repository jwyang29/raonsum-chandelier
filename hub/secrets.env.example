# 이 파일을 secrets.env 로 복사해서 값을 채우세요.
#   cp hub/secrets.env.example hub/secrets.env
# secrets.env 는 .gitignore 에 들어 있어 저장소에 올라가지 않습니다.

# 프로젝트 설정 > 서비스 계정 > 데이터베이스 비밀번호 에서 복사한 값.
# 이 줄만 채우면 됩니다. 등호 뒤에 바로 붙여넣으세요 (따옴표는 있어도 없어도 됩니다).
RAONSUM_FIREBASE_SECRET=

# 주소는 web/config.js 에 적힌 databaseURL 을 그대로 씁니다. 여기 적을 필요 없습니다.
# 다른 데이터베이스로 바꿔 시험할 때만 아래를 풀어 쓰세요.
# RAONSUM_FIREBASE_URL=

# 데이터베이스 비밀번호가 콘솔에 없을 때만 아래 셋을 씁니다 (위 SECRET 은 비워 둡니다).
# RAONSUM_FIREBASE_APIKEY=
# RAONSUM_FIREBASE_EMAIL=
# RAONSUM_FIREBASE_PASSWORD=
